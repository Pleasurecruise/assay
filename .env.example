# --- Model (oh-my-pi catalog) ---
# Model must exist in @oh-my-pi/pi-catalog.
ASSAY_MODEL_PROVIDER=deepseek
ASSAY_MODEL_ID=deepseek-chat

# Prefer this generic key. DEEPSEEK_API_KEY is also accepted by the CLI.
ASSAY_MODEL_API_KEY=

# --- Reserved competition configuration (Volcano Ark; not wired yet) ---
# The track mandates DeepSeek V4 Pro via Ark endpoints, but the current CLI
# does not read these ARK_* variables. Do not assume they change model routing.
# Token values: reference/model-api-guide.md (git-ignored, never commit).
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL_DEEPSEEK=ep-20260708162855-pcf9x
ARK_MODEL_SEED=ep-20260722093003-7swj9

# Agent to run with the single-agent smoke-test CLI.
ASSAY_AGENT_ID=param-robustness

# --- Opt-in five-agent E2E test ---
# This test performs five concurrent model calls and is never run by
# `bun run check`. Until data and backtest tools are registered, every honest
# branch is expected to return insufficient_evidence.
ASSAY_E2E_TIMEOUT_MS=120000
ASSAY_E2E_AUDIT_ID=e2e_parallel_checks
ASSAY_E2E_SUBJECT_ID=e2e_strategy
ASSAY_E2E_INPUT=CSI 300 monthly momentum: rank by trailing 20-day return, hold the top 50 equal-weighted names, and rebalance monthly.

# Loaded only by the Python PandaData adapter during process startup.
PANDA_DATA_USERNAME=
PANDA_DATA_PASSWORD=
