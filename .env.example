# --- Model (oh-my-pi catalog) ---
# Model must exist in @oh-my-pi/pi-catalog.
ASSAY_MODEL_PROVIDER=deepseek
ASSAY_MODEL_ID=deepseek-chat

# Prefer this generic key. DEEPSEEK_API_KEY is also accepted by the CLI.
ASSAY_MODEL_API_KEY=

# --- A2A Server / Volcano Ark ---
# The A2A server requires both ARK_API_KEY and the organizer-provided DeepSeek
# endpoint ID in ARK_MODEL_DEEPSEEK. Never commit keys or hardcode endpoint IDs.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL_DEEPSEEK=
ARK_MODEL_SEED=

# The process listens on all interfaces at this port. PUBLIC_URL is the
# externally reachable base URL advertised by the Agent Card.
ASSAY_A2A_PORT=3001
ASSAY_A2A_PUBLIC_URL=http://127.0.0.1:3001
# Optional opaque token for non-browser A2A clients. When set, both /a2a
# transports accept Authorization: Bearer <token>. Use at least 32 characters.
ASSAY_A2A_BEARER_TOKEN=
# Comma-separated browser origins allowed to call the A2A endpoints.
ASSAY_A2A_CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- Authentication / local database ---
# Better Auth is served through the Vite proxy in development. Register this
# exact Google OAuth redirect URI: http://localhost:5173/api/auth/callback/google
ASSAY_AUTH_BASE_URL=http://localhost:5173
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Better Auth sessions and per-user audit history are migrated automatically.
ASSAY_DATABASE_PATH=data/assay.sqlite

# Fixed data snapshot used by the bundled G01 local package. This value is
# required and must never fall back to the current date.
ASSAY_DATA_AS_OF=2026-07-23
ASSAY_CAPABILITY_SNAPSHOT_ID=local-data-package:g01-v1
ASSAY_CODE_REVISION=development
# Read-only registry containing the prebuilt local data packages.
ASSAY_LOCAL_DATA_PACKAGE_ROOT=.cache/assay
# Writable task-scoped derived artifacts produced from the selected package.
ASSAY_AUDIT_OUTPUT_ROOT=.cache/assay/audit-output

# Agent to run with the single-agent smoke-test CLI.
ASSAY_AGENT_ID=param-robustness

# --- Opt-in five-agent E2E test ---
# This test performs the real model call and audits the selected local package.
# It is never run by `bun run check`.
ASSAY_E2E_TIMEOUT_MS=120000
ASSAY_E2E_AUDIT_ID=e2e_parallel_checks
ASSAY_E2E_SUBJECT_ID=e2e_strategy
ASSAY_E2E_INPUT=CSI 300 monthly momentum: rank by trailing 20-day return, hold the top 50 equal-weighted names, and rebalance monthly.
